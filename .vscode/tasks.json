{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Órbita: ejecutar Flutter Web",
      "type": "shell",
      "command": "D:/flutter/flutter/bin/flutter.bat",
      "args": ["run", "-d", "chrome", "--web-port", "8082"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
